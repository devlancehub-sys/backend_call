PORT=3000
NODE_ENV=development

# Database — local MySQL or Railway MYSQL* / DATABASE_URL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=premium_status
# DB_SSL=true
# DATABASE_URL=mysql://user:pass@host:3306/premium_status

# User JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=30d

# Admin JWT (separate secret)
ADMIN_JWT_SECRET=your-admin-jwt-secret-change-in-production
ADMIN_JWT_EXPIRES_IN=7d

# Wallet
COINS_PER_INR=10

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx

# Cloudflare R2 — required for admin uploads & video streaming
# Create bucket + "Manage R2 API Tokens" in Cloudflare dashboard.
# Use Access Key ID + Secret (NOT the cfat_* dashboard token).
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=status
# R2_PUBLIC_BASE_URL=https://cdn.example.com

# Signed URL TTL for video/thumbnail access (seconds)
SIGNED_URL_TTL_SECONDS=3600
